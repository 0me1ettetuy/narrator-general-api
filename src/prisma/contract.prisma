// use prisma-next

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  sessions     Session[]

  @@map("user")
}

model Session {
  id               String    @id @default(uuid())
  refreshTokenHash String
  userId           String
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id])

  @@map("session")
}
