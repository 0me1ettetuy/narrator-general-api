# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Redis (BullMQ queue)
REDIS_URL="redis://localhost:6379"
REDIS_PUBLISHED_PORT="6379"

# Object storage — choose exactly one section below.
#
# --- Cloud storage: Cloudflare R2 or Amazon S3 (active example) ---
# Docker does not run MinIO in this mode. The values below are for R2.
# For Amazon S3, set STORAGE_PROVIDER="s3", set your AWS region, and leave
# STORAGE_ENDPOINT empty so the AWS SDK selects the normal Amazon S3 endpoint.
STORAGE_PROVIDER="r2"
# Keep `true`: Compose starts only local TTS services whose individual
# TTS_LOCAL_*_ENABLED flag below is true. It starts no local model by itself.
COMPOSE_PROFILES="true"
STORAGE_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
STORAGE_REGION="auto"
STORAGE_BUCKET="narrator"
STORAGE_ACCESS_KEY_ID="replace-with-r2-access-key-id"
STORAGE_SECRET_ACCESS_KEY="replace-with-r2-secret-access-key"
#
# --- Local storage: MinIO ---
# Comment the cloud-storage lines above, then uncomment every line here.
# COMPOSE_PROFILES="minio,true"
# STORAGE_PROVIDER="minio"
# STORAGE_ENDPOINT="http://localhost:9000"
# STORAGE_REGION="us-east-1"
# STORAGE_BUCKET="narrator"
# STORAGE_ACCESS_KEY_ID="narrator-local"
# STORAGE_SECRET_ACCESS_KEY="replace-with-a-long-local-password"
# MINIO_ROOT_USER="narrator-local"
# MINIO_ROOT_PASSWORD="replace-with-the-same-long-local-password"
# MINIO_API_PUBLISHED_PORT="9000"
# MINIO_CONSOLE_PUBLISHED_PORT="9001"

# Auth
JWT_ACCESS_SECRET="replace-with-long-random-secret"
JWT_REFRESH_SECRET="replace-with-long-random-secret"
CSRF_SECRET="replace-with-long-random-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
REFRESH_TOKEN_COOKIE_MAX_AGE_MS="604800000"
BCRYPT_SALT_ROUNDS="12"

# OpenRouter (reserved for future LLM use)
OPENROUTER_API_KEY="replace-with-openrouter-api-key"

# Local text-to-speech model catalogue
# A model only becomes available when enabled and its service health URL returns
# a successful response. Docker profiles start optional local model containers;
# these flags tell the API which model services it may offer to users.
#
# `COMPOSE_PROFILES` must include `true` (it already does in the cloud example
# above). Then each individual `*_ENABLED` flag controls both its Docker
# service and its backend catalogue entry. All are false by default, so no
# local model image or weights download unless the deployment owner enables it.
TTS_MODEL_HEALTH_CHECK_TIMEOUT_MS="2000"
TTS_MODEL_HEALTH_CACHE_TTL_MS="15000"
# How long a local provider may remain silent while its MP3 response streams.
TTS_LOCAL_TTS_IDLE_TIMEOUT_MS="300000"

# Piper — CPU-only, voice files download on first use and are cached in Docker.
TTS_LOCAL_PIPER_EN_US_AMY_ENABLED="false"
TTS_LOCAL_PIPER_EN_US_AMY_HEALTH_URL="http://localhost:9500/v1/audio/models"
TTS_LOCAL_PIPER_EN_US_AMY_URL="http://localhost:9500"
TTS_LOCAL_PIPER_EN_US_AMY_VOICE="en_US-amy-low"
TTS_LOCAL_PIPER_IMAGE="kamilkrawiec/piper-openai-tts:latest"
TTS_LOCAL_PIPER_PUBLISHED_PORT="9500"

# Kokoro-82M — runs on CPU by default; enable a GPU override later if needed.
TTS_LOCAL_KOKORO_82M_ENABLED="false"
TTS_LOCAL_KOKORO_82M_HEALTH_URL="http://localhost:7860/health/ready"
TTS_LOCAL_KOKORO_82M_URL="http://localhost:7860"
TTS_LOCAL_KOKORO_82M_VOICE="af_heart"
TTS_LOCAL_KOKORO_IMAGE="hangrylabs/kokorotts:latest"
TTS_LOCAL_KOKORO_PUBLISHED_PORT="7860"

# Qwen3-TTS 0.6B — GPU profile. A CUDA-capable Docker host is required.
TTS_LOCAL_QWEN3_TTS_0_6B_ENABLED="false"
TTS_LOCAL_QWEN3_TTS_0_6B_HEALTH_URL="http://localhost:8001/health"
TTS_LOCAL_QWEN3_TTS_0_6B_URL="http://localhost:8001"
TTS_LOCAL_QWEN3_TTS_0_6B_VOICE="ryan"
TTS_LOCAL_QWEN3_TTS_0_6B_IMAGE="ghcr.io/malaiwah/qwen3-tts-server:latest"
TTS_LOCAL_QWEN3_TTS_0_6B_PUBLISHED_PORT="8001"

# Chatterbox Turbo — GPU profile. A CUDA-capable Docker host is required.
TTS_LOCAL_CHATTERBOX_TURBO_ENABLED="false"
TTS_LOCAL_CHATTERBOX_TURBO_HEALTH_URL="http://localhost:8000/healthz"
TTS_LOCAL_CHATTERBOX_TURBO_URL="http://localhost:8000"
TTS_LOCAL_CHATTERBOX_TURBO_VOICE="default"
TTS_LOCAL_CHATTERBOX_TURBO_IMAGE="ghcr.io/openttsgroup/chatterbox-open-tts:latest"
TTS_LOCAL_CHATTERBOX_TURBO_PUBLISHED_PORT="8000"

# Text to speech (Fish Audio)
# Per-user Fish Audio API keys are encrypted in Postgres with this deployment
# secret. Generate once with: openssl rand -base64 32
TTS_CREDENTIAL_ENCRYPTION_KEY="replace-with-a-32-byte-base64-secret"
# Optional deployment catalogue flags. A user sees these only after their own
# Fish API key is saved and successfully validated.
TTS_FISH_S2_1_PRO_FREE_ENABLED="true"
TTS_FISH_S2_1_PRO_ENABLED="false"
# Ordered deployment fallback voices. The backend uses the first voice when a
# user has not selected one of their own Fish reference voices. Add/remove
# entries to control the shared default voice catalogue.
FISH_DEFAULT_VOICES='[
  {"id":"bf322df2096a46f18c579d0baa36f41d","name":"Sarah"},
  {"id":"6264e995072341a281c45ed71e554566","name":"Adrian"}
]'
# Optional: defaults to 5000 while checking a submitted user API key.
FISH_CREDENTIAL_VALIDATION_TIMEOUT_MS="5000"
# Optional: defaults to 300000 (five minutes without provider audio)
FISH_TTS_IDLE_TIMEOUT_MS="300000"
