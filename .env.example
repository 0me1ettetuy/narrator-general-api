# Copy this file to `.env` and replace all placeholders.
# The default Compose setup starts the whole backend app. For local HTTP use,
# keep NODE_ENV=development; a real HTTPS deployment should use production.
NODE_ENV="development"
CLIENT_ORIGIN="http://localhost:5173"
API_PUBLISHED_PORT="3000"

# PostgreSQL. Requires PostgreSQL >= 15.
POSTGRES_USER="narrator"
POSTGRES_PASSWORD="replace-with-a-long-password"
POSTGRES_DB="narrator"
POSTGRES_PUBLISHED_PORT="5432"
DATABASE_URL="postgresql://narrator:replace-with-a-long-password@localhost:5432/narrator"

# Redis (BullMQ queue)
REDIS_URL="redis://localhost:6379"
REDIS_PUBLISHED_PORT="6379"

# Always "true" — never needs to change.
COMPOSE_PROFILES="true"

# Object storage — pick ONE provider, uncomment only that block.

# Option A — Cloud storage: Cloudflare R2 / Amazon S3 (active)
# For Amazon S3: STORAGE_PROVIDER="s3", set STORAGE_REGION, leave
# STORAGE_ENDPOINT empty so the AWS SDK picks the normal S3 endpoint.
STORAGE_PROVIDER="r2"
STORAGE_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
STORAGE_REGION="auto"
STORAGE_BUCKET="narrator"
STORAGE_ACCESS_KEY_ID="replace-with-r2-access-key-id"
STORAGE_SECRET_ACCESS_KEY="replace-with-r2-secret-access-key"

# Option B — Local storage: MinIO (comment out Option A above first)
# MINIO_ENABLED="true"
# STORAGE_PROVIDER="minio"
# STORAGE_ENDPOINT="http://localhost:9000"
# STORAGE_INTERNAL_ENDPOINT="http://minio:9000"
# STORAGE_REGION="us-east-1"
# STORAGE_BUCKET="narrator"
# STORAGE_ACCESS_KEY_ID="narrator-local"
# STORAGE_SECRET_ACCESS_KEY="replace-with-a-long-local-password"
# MINIO_ROOT_USER="narrator-local"
# MINIO_ROOT_PASSWORD="replace-with-the-same-long-local-password"
# MINIO_API_PUBLISHED_PORT="9000"
# MINIO_CONSOLE_PUBLISHED_PORT="9001"

# Auth
JWT_ACCESS_SECRET="replace-with-long-random-secret"
JWT_REFRESH_SECRET="replace-with-long-random-secret"
CSRF_SECRET="replace-with-long-random-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
REFRESH_TOKEN_COOKIE_MAX_AGE_MS="604800000"
BCRYPT_SALT_ROUNDS="12"

# OpenRouter (reserved for future LLM use)
OPENROUTER_API_KEY="replace-with-openrouter-api-key"

# Local text to speech: Silero TTS and Qwen3-TTS 0.6B (Russian + English). Both
# are off by default. Silero is CPU only; Qwen3-TTS needs an NVIDIA GPU with 4 GB
# or more. Piper, Kokoro and Chatterbox are removed; see
# docs/tts/local-tts-models-removed.md.
TTS_MODEL_HEALTH_CHECK_TIMEOUT_MS="2000"
TTS_MODEL_HEALTH_CACHE_TTL_MS="15000"
# How long a local provider may stay silent while its MP3 response streams.
TTS_LOCAL_TTS_IDLE_TIMEOUT_MS="300000"
TTS_LOCAL_SILERO_TTS_ENABLED="false"
TTS_LOCAL_SILERO_TTS_HEALTH_URL="http://localhost:8001/health"
TTS_LOCAL_SILERO_TTS_URL="http://localhost:8001"
# Optional fixed speaker (ru: aidar, baya, kseniya, xenia, eugene; en: en_0..en_117).
# Leave unset to use the default speaker for each language.
TTS_LOCAL_SILERO_TTS_VOICE=""
TTS_LOCAL_SILERO_TTS_PUBLISHED_PORT="8001"
TTS_LOCAL_QWEN3_TTS_ENABLED="false"
TTS_LOCAL_QWEN3_TTS_HEALTH_URL="http://localhost:8002/health"
TTS_LOCAL_QWEN3_TTS_URL="http://localhost:8002"
# Optional fixed speaker (ryan, aiden, vivian, serena). Leave unset for ryan.
TTS_LOCAL_QWEN3_TTS_VOICE=""
TTS_LOCAL_QWEN3_TTS_PUBLISHED_PORT="8002"

# Text to speech (Fish Audio)
# Per-user Fish Audio API keys are encrypted in Postgres with this deployment
# secret. Generate once with: openssl rand -base64 32
TTS_CREDENTIAL_ENCRYPTION_KEY="replace-with-a-32-byte-base64-secret"
# Optional deployment catalogue flags. A user sees these only after their own
# Fish API key is saved and successfully validated.
TTS_FISH_S2_1_PRO_FREE_ENABLED="true"
TTS_FISH_S2_1_PRO_ENABLED="false"
# Ordered deployment fallback voices. The backend uses the first voice when a
# user has not selected one of their own Fish reference voices. Add/remove
# entries to control the shared default voice catalogue.
FISH_DEFAULT_VOICES='[
  {"id":"bf322df2096a46f18c579d0baa36f41d","name":"Sarah"},
  {"id":"6264e995072341a281c45ed71e554566","name":"Adrian"},
  {"id":"8aa3034182ba4d33b1efe7f3d2e01662","name":"Dynamic Russian Narrator"},
  {"id":"5553d9d7d78c4cdd9fb1db0b14865629","name":"Russkiy Golos"}
]'
# Optional: defaults to 5000 while checking a submitted user API key.
FISH_CREDENTIAL_VALIDATION_TIMEOUT_MS="5000"
# Optional: defaults to 300000 (five minutes without provider audio)
FISH_TTS_IDLE_TIMEOUT_MS="300000"
# Optional: defaults to 2. How many Fish chapters the worker generates at
# once. Each user's own key has a provider concurrency limit (about 5 on
# Fish's lowest tier); local models always run one chapter at a time.
TTS_FISH_CONCURRENCY="2"
